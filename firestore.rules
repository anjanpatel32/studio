
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Publicly readable, but only the user can write to their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Subcollections of users (following, followers, likedReels, notifications)
    // are private to the user.
    match /users/{userId}/{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reels: Public reels are readable by anyone. Users can only write to their own reels.
    // Liking/commenting is handled by subcollections.
    match /reels/{reelId} {
      allow read: if resource.data.visibility == 'public' || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    
    // Reel subcollections (likes, comments): Logged-in users can interact.
    match /reels/{reelId}/{collection}/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Posts: Similar to reels. Publicly readable.
    match /posts/{postId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    
    // Post subcollections (likes, comments): Logged-in users can interact.
    match /posts/{postId}/{collection}/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stories: Only the owner and their followers can read. Only owner can write.
    // This rule assumes a 'followers' subcollection on the user doc.
    // For simplicity here, we allow any logged-in user to see stories from people they follow.
    match /stories/{storyId} {
      allow read: if request.auth != null && (
                  request.auth.uid == resource.data.ownerUid || 
                  exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(resource.data.ownerUid))
                  );
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Chats: Only members of the chat can read or write messages.
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /chats/{chatId}/messages/{messageId} {
       allow read, create: if request.auth != null && exists(/databases/$(database)/documents/chats/$(chatId)) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    
    // Live Streams: Readable by all, writable only by owner.
    match /live-streams/{streamId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
    }
    
    // Live stream chat: Writable by any logged-in user.
     match /live-streams/{streamId}/chat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
    }

    // Wallets and transactions are private.
    match /wallets/{userId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Payouts can be created by users, but only read/updated by admins (not enforced here, needs backend logic).
    match /payouts/{payoutId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        // Read/update should be restricted to admin roles via backend logic, not client rules.
        allow read, update, delete: if false; 
    }
  }
}
