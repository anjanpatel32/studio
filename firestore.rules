rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users:
    // - Anyone can read public profiles.
    // - Authenticated users can create their own profile.
    // - Users can only update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections
      match /following/{targetId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
       match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null; // Allow server-side updates
      }
       match /likedReels/{reelId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Reels, Posts, Stories
    // - Public content is readable by anyone.
    // - Users can create content.
    // - Users can only update/delete their own content.
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }
    
    match /reels/{reelId} {
      allow read: if resource.data.visibility == 'public';
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
      
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isOwner(resource.data.uid);
      }
    }
    
    match /posts/{postId} {
      allow read: if resource.data.visibility == 'public';
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
    }
    
    match /stories/{storyId} {
      // Allow read if the story has not expired and the viewer is authenticated.
      // This allows the feed to load stories from followed users.
      allow read: if request.auth != null && resource.data.expiresAt > request.time;
      allow create: if isOwner(request.resource.data.ownerUid);
      allow delete: if isOwner(resource.data.ownerUid);
    }
    
    // Live Streams
    match /live-streams/{streamId} {
      allow read: if true;
      allow create, update: if isOwner(request.resource.data.ownerUid) || isOwner(resource.data.ownerUid);
      
      match /chat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }
    
    // Chats
    // Users can only read/write chats they are a member of.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.members;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
    
    // Wallets & Payouts (Highly restricted)
    // - Users can only read their own wallet.
    // - Server-side logic should be the only thing writing to wallets/payouts.
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // All updates should be through trusted server actions
      
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // All updates should be through trusted server actions
      }
    }
    
    // Payouts are admin-only, except for creation by the user.
    match /payouts/{payoutId} {
        allow read: if isOwner(resource.data.uid);
        allow create: if isOwner(request.resource.data.uid);
        allow update: if false; // Admins only via backend
    }
  }
}
