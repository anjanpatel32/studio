rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Default: Deny all reads and writes
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile Pictures:
    // - Anyone can read profile pictures.
    // - Authenticated users can only write to their own profile picture path.
    // - Max file size of 2MB.
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 2 * 1024 * 1024;
    }
    
    // Reels:
    // - Anyone can read reel videos.
    // - Authenticated users can write to their own reels folder.
    // - Max file size of 100MB.
    // - Must be a video file.
    match /users/{userId}/reels/{reelId} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Posts:
    // - Anyone can read post images.
    // - Authenticated users can write to their own posts folder.
    // - Max file size of 5MB.
    // - Must be an image file.
    match /users/{userId}/posts/{postId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Stories:
    // - Authenticated users can read stories. (Simplified rule)
    // - Authenticated users can write to their own stories folder.
    // - Max file size of 10MB.
    // - Must be an image or video file.
    match /users/{userId}/stories/{storyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}